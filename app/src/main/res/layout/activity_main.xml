<?xml version="1.0" encoding="utf-8"?>
<!-- The video with the call's buttons over it (talk, hang up, settings), and
     the config panel beside it, which the settings button shows and hides.
     Opened by a ring, only the video and the buttons show. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.nicobrailo.batidoorlink.VideoFrame
            android:id="@+id/video_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <SurfaceView
                android:id="@+id/video"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.nicobrailo.batidoorlink.VideoFrame>

        <!-- Debug details: shown with the config panel only -->
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="#99000000"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/toggle_panel"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/overlay_button_background"
            android:contentDescription="Settings"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />

        <!-- As AstroDock's call screen: big round buttons at the bottom -->
        <LinearLayout
            android:id="@+id/call_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/talk"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginEnd="96dp"
                android:background="@drawable/talk_background"
                android:contentDescription="Hold to talk"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />

            <ImageButton
                android:id="@+id/hang_up"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/hang_up_background"
                android:contentDescription="Hang up"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_call_end" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/panel"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <Spinner
                android:id="@+id/history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Camera IP (host or host:port)"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/stream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Stream path, or a full rtsp:// URL"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/user"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="User"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Password"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />
            </LinearLayout>

            <Button
                android:id="@+id/connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/open_mic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Open mic (full duplex)" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/send_mic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send the mic to the doorbell (off: level meter only)" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/half_duplex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mute the doorbell while talking" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/mute_doorbell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mute the doorbell" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Applied on the next connect"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/use_tcp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stream over TCP (off: UDP, falling back to TCP)" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/talk_on_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open the talk channel on connect" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/comm_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Call audio mode (voice usage; in-communication while talking)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Applied the next time the mic opens"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/voice_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mic: voice communication source" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/aec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Echo canceller (if the device has one)" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/ns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Noise suppressor (if the device has one)" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
