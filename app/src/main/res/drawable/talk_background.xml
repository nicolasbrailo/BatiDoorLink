<?xml version="1.0" encoding="utf-8"?>
<!-- The talk button over the video: dark and see-through until held, green
     while it sends (as AstroDock's answer button), grey while it can't. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="#66000000" />
            <stroke android:width="2dp" android:color="#55FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#43A047" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#43A047" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#99000000" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
</selector>
